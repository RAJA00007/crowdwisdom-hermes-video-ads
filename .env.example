# ==============================================================================
# CrowdWisdomTrading Video Ads Agent - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Populate the required API keys below.
# 3. DO NOT commit .env into version control.
# ==============================================================================

# --- Hermes / OpenRouter LLM Configuration ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-70b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- Meta Ad Research (Apify) ---
APIFY_API_TOKEN=
APIFY_META_ADS_ACTOR_ID=apify/facebook-ads-scraper

# --- Market Research APIs (Tavily & Exa) ---
TAVILY_API_KEY=
EXA_API_KEY=

# --- Video Production Settings ---
OPENMONTAGE_BIN_PATH=
VIDEO_OUTPUT_RESOLUTION=1080x1920
VIDEO_DEFAULT_DURATION_SEC=48.5
CROWDWISDOM_DATA_DIR=./data
OUTPUTS_DIR=./outputs

# --- Optional External Generative Video (Fal.ai) ---
FAL_KEY=
