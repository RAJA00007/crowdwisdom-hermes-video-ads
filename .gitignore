# Environment variables & secrets
.env
.env.*
!.env.example

# Python artifacts & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# Output & Generated Data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/research/*
!data/research/.gitkeep
outputs/ads/*
!outputs/ads/.gitkeep
outputs/scripts/*
